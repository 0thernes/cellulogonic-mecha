# SPDX-License-Identifier: Apache-2.0
# CELLULOGONIC MECHA v1.7.0 — Optional Runtime Environment Variables
# Copy to .env if you want to override local Observatory or toolchain paths.
# Never commit .env files with secrets (none are required by this project).

# Local WebGL2 3D Observatory HTTP server port (bound strictly to 127.0.0.1)
PORT=8788

# Optional explicit path to compiled native C11 CLI binary (used by web/server.mjs & examples)
# CELLULOGONIC_BIN=./bin/cellulogonic_linux

# Optional explicit path to Tectonic binary for scripts/build_paper.py
# TECTONIC_BIN=/usr/local/bin/tectonic

# Optional C compiler override for build_linux.sh (default: gcc on Linux, clang on macOS)
# CC=gcc
